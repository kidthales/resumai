# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

GEMINI_AGENT_RESUME_ARCHETYPE_SELECTOR_MODEL=gemini-3.5-flash-lite
GEMINI_AGENT_RESUME_ARCHETYPE_SELECTOR_MODEL_PARAMS='{"max_output_tokens":65536,"thinking_config":{"include_thoughts":true,"thinking_level":"MEDIUM"}}'
GEMINI_AGENT_RESUME_DRAFTER_MODEL=gemini-3.5-flash-lite
GEMINI_AGENT_RESUME_DRAFTER_MODEL_PARAMS='{"max_output_tokens":65536,"thinking_config":{"include_thoughts":true,"thinking_level":"MEDIUM"}}'
GEMINI_AGENT_RESUME_EDITOR_MODEL=gemini-3.7-flash
GEMINI_AGENT_RESUME_EDITOR_MODEL_PARAMS='{"max_output_tokens":65536,"thinking_config":{"include_thoughts":true,"thinking_level":"MEDIUM"}}'
GEMINI_AGENT_RESUME_FACT_CHECKER_MODEL=gemini-3.5-flash
GEMINI_AGENT_RESUME_FACT_CHECKER_MODEL_PARAMS='{"max_output_tokens":65536,"thinking_config":{"include_thoughts":true,"thinking_level":"MEDIUM"}}'
GEMINI_AGENT_RESUME_JOB_ALIGNMENT_CHECKER_MODEL=gemini-3.5-flash-lite
GEMINI_AGENT_RESUME_JOB_ALIGNMENT_CHECKER_MODEL_PARAMS='{"max_output_tokens":65536,"thinking_config":{"include_thoughts":true,"thinking_level":"MEDIUM"}}'
GEMINI_API_KEY="!ChangeThisGeminiApiKey!"

OLLAMA_AGENT_RESUME_ARCHETYPE_SELECTOR_MODEL=qwen2.5:14b-instruct-q5_K_M
OLLAMA_AGENT_RESUME_ARCHETYPE_SELECTOR_MODEL_PARAMS='{"temperature":0.0,"top_p":0.1,"top_k":20,"repeat_penalty":1.1,"num_ctx":16384}'
OLLAMA_AGENT_RESUME_DRAFTER_MODEL=qwen2.5:14b-instruct-q5_K_M
OLLAMA_AGENT_RESUME_DRAFTER_MODEL_PARAMS='{"temperature":0.35,"top_p":0.9,"top_k":40,"repeat_penalty":1.1,"num_ctx":16384}'
OLLAMA_AGENT_RESUME_EDITOR_MODEL=qwen2.5:14b-instruct-q5_K_M
OLLAMA_AGENT_RESUME_EDITOR_MODEL_PARAMS='{"temperature":0.15,"top_p":0.85,"top_k":30,"repeat_penalty":1.1,"num_ctx":16384}'
OLLAMA_AGENT_RESUME_FACT_CHECKER_MODEL=qwen2.5:14b-instruct-q5_K_M
OLLAMA_AGENT_RESUME_FACT_CHECKER_MODEL_PARAMS='{"temperature":0.0,"top_p":0.1,"top_k":20,"repeat_penalty":1.1,"num_ctx":16384}'
OLLAMA_AGENT_RESUME_JOB_ALIGNMENT_CHECKER_MODEL=qwen2.5:14b-instruct-q5_K_M
OLLAMA_AGENT_RESUME_JOB_ALIGNMENT_CHECKER_MODEL_PARAMS='{"temperature":0.3,"top_p":0.8,"top_k":35,"repeat_penalty":1.1,"num_ctx":16384}'
OLLAMA_HTTP_CLIENT_BASE_URI=http://ollama:11434

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/mercure-bundle ###
# See https://symfony.com/doc/current/mercure.html#configuration
# The secret used to sign the JWTs
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
# The public URL of the Mercure hub, used by the browser to connect
MERCURE_PUBLIC_URL=https://example.com/.well-known/mercure
# The URL of the Mercure hub, used by the app to publish updates (can be a local URL)
MERCURE_URL=https://example.com/.well-known/mercure
###< symfony/mercure-bundle ###
