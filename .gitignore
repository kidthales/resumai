# Binaries
/bin/

# Local CI Receipts & Coverage (NEVER COMMIT)
/.ci-local/
/coverage/
*.test
*.out
coverage.txt

# Environment & Secrets (NEVER COMMIT)
.env*
*.env
*.secret
*.token
*.key
*.pem
