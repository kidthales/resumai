# Content PII & Private Archetypes Guards (Belt-and-Suspenders)
/content/pii/*
!/content/pii/.gitignore
!/content/pii/*.sample.md
/content/archetypes/*
!/content/archetypes/.gitignore
!/content/archetypes/*.sample.md

